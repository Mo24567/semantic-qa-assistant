OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
# 0.60 is the value selected by the threshold sensitivity analysis and used
# for evaluation; the code default when unset is 0.55.
SIMILARITY_THRESHOLD=0.60
CHUNK_TOP_K=3
CHUNK_SIMILARITY_THRESHOLD=0.45
LLM_FALLBACK_ENABLED=true
ADMIN_PASSWORD=changeme
# Public demo: disables answer generation and builds the sample knowledge base
# from demo/ on first run. Leave false for the full system.
DEMO_MODE=false
